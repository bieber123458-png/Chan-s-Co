{
  "name": "xiaochen-30-day-system",
  "private": true,
  "version": "1.0.0",
  "description": "小陳的 30 天經營系統",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "build:static": "node scripts/build-static.mjs",
